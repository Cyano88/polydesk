@@ -403,6 +403,27 @@ async fn precheck_impl(args: &PrecheckArgs, ctx: &Context) -> Result<Value> {
 
 // ─── `agent update` ───────────────────────────────────────────────────────
 
+// Forward only the known onboarding field after the normal service validation.
+fn update_services_with_guide(raw: &str) -> Result<Value> {
+    let services = parse_services(Some(raw))?;
+    let original: Vec<Value> = serde_json::from_str(raw)?;
+    let mut value = serde_json::to_value(&services)?;
+    let serialized = value.as_array_mut().context("services must serialize as an array")?;
+    for (source, target) in original.iter().zip(serialized.iter_mut()) {
+        if let Some(guide) = source.get("serviceGuide") {
+            let text = guide.as_str().context("serviceGuide must be a string")?.trim();
+            if text.is_empty() { bail!("serviceGuide must not be empty"); }
+            if target.get("serviceType").and_then(Value::as_str) != Some("A2A")
+                || target.get("operation").and_then(Value::as_str) == Some("delete") {
+                bail!("serviceGuide is only supported for A2A create/update entries");
+            }
+            target.as_object_mut().context("service must be an object")?
+                .insert("serviceGuide".to_string(), json!(text));
+        }
+    }
+    Ok(value)
+}
