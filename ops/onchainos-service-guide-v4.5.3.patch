+
+fn guide_field_service() -> Value {
+    json!({"operation":"update","id":"38496","serviceName":"Managed Polymarket Agent","serviceDescription":"Monitor a public portfolio.","serviceType":"A2A","fee":"","subscription":[{"interval":"month","fee":"5"}],"freeTrial":"72"})
+}
+#[test]
+fn guide_field_preserves_pricing_and_identity() {
+    let mut service = guide_field_service();
+    service["serviceGuide"] = json!("Approve each exact preview before execution.");
+    let result = update_services_with_guide(&json!([service]).to_string()).unwrap();
+    assert_eq!(result[0]["serviceGuide"], "Approve each exact preview before execution.");
+    assert_eq!(result[0]["id"], "38496");
+    assert_eq!(result[0]["fee"], "");
+    assert_eq!(result[0]["freeTrial"], "72");
+    assert_eq!(result[0]["subscription"][0]["fee"], "5");
+}
+#[test]
+fn guide_field_absent_and_unknown_not_forwarded() {
+    let mut service = guide_field_service();
+    service["ownerAddress"] = json!("must-not-forward");
+    let result = update_services_with_guide(&json!([service]).to_string()).unwrap();
+    assert!(result[0].get("serviceGuide").is_none());
+    assert!(result[0].get("ownerAddress").is_none());
+}
+#[test]
+fn guide_field_rejects_non_text_empty_or_delete() {
+    for bad in [json!(true), json!(null), json!(" ")] {
+        let mut service = guide_field_service(); service["serviceGuide"] = bad;
+        assert!(update_services_with_guide(&json!([service]).to_string()).is_err());
+    }
+    let mut service = guide_field_service(); service["operation"] = json!("delete"); service["serviceGuide"] = json!("Invalid delete guide");
+    assert!(update_services_with_guide(&json!([service]).to_string()).is_err());
+}
