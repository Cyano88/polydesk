+use anyhow::{Result,ensure,Context};
+use serde::Deserialize;
+#[derive(Deserialize)]
+#[serde(rename_all="camelCase",deny_unknown_fields)]
+struct Constraint { schema:String, execution_id:String, owner:String,wallet:String,token_id:String,condition_id:String,max_total_raw:String,max_order_raw:String,max_price_raw:String,expires_at:i64,approval_hash:String }
+pub fn enabled()->bool { std::env::var_os("POLYDESK_MANAGED_CONSTRAINTS").is_some() }
+#[allow(clippy::too_many_arguments)]
+fn validate(raw:&str,execution:&str,owner:&str,wallet:&str,token:&str,condition:&str,amount:u128,shares:u128,fee:u128,kind:&str,sig:u8,now:i64)->Result<()> {
+ let c:Constraint=serde_json::from_str(raw)?;
+ ensure!(c.schema=="polydesk-managed-native-v1" && c.execution_id==execution && c.approval_hash.len()==64,"Managed execution identity mismatch");
+ ensure!(c.owner.eq_ignore_ascii_case(owner)&&c.wallet.eq_ignore_ascii_case(wallet)&&c.token_id==token&&c.condition_id.eq_ignore_ascii_case(condition),"Managed owner or market changed");
+ ensure!(kind=="FOK" && sig==3 && c.expires_at>now && c.expires_at<=now+300000,"Managed order policy expired or unsupported");
+ let cap:u128=c.max_total_raw.parse()?;let order_cap:u128=c.max_order_raw.parse()?;let price:u128=c.max_price_raw.parse()?;
+ ensure!(fee<=10000 && amount>0 && shares>0 && price>0 && price<1000000,"Invalid managed amount or fee");
+ let reserve=amount.checked_mul(fee).context("Fee overflow")?.checked_add(9999).context("Fee overflow")?/10000;
+ ensure!(amount==order_cap && amount.checked_add(reserve).context("Total overflow")?<=cap,"Managed total fee-inclusive cap exceeded");
+ ensure!(amount.checked_mul(1000000).context("Price overflow")?<=shares.checked_mul(price).context("Price overflow")?,"Managed maximum price exceeded");
+ Ok(())
+}
+#[allow(clippy::too_many_arguments)]
+pub fn check(owner:&str,wallet:&str,token:&str,condition:&str,amount:u128,shares:u128,fee:u128,kind:&str,sig:u8)->Result<()> {
+ let raw=match std::env::var("POLYDESK_MANAGED_CONSTRAINTS"){Ok(v)=>v,Err(_)=>return Ok(())};
+ use base64::Engine;
+ let decoded=base64::engine::general_purpose::STANDARD.decode(raw)?;
+ let raw=String::from_utf8(decoded)?;
+ let execution=std::env::var("POLYDESK_EXECUTION_ID").context("Missing managed execution ID")?;
+ ensure!(std::env::var_os("POLYDESK_RECOVERY_BINDING_PATH").is_some(),"Managed execution requires durable recovery binding");
+ validate(&raw,&execution,owner,wallet,token,condition,amount,shares,fee,kind,sig,chrono::Utc::now().timestamp_millis())
+}
+#[cfg(test)] mod tests {
+ use super::*;
+ fn data()->serde_json::Value{serde_json::json!({"schema":"polydesk-managed-native-v1","executionId":"execution_1","owner":"owner","wallet":"wallet","tokenId":"123","conditionId":"condition","maxTotalRaw":"1100000","maxOrderRaw":"1000000","maxPriceRaw":"500000","expiresAt":2000,"approvalHash":"a".repeat(64)})}
+ fn run(v:serde_json::Value,fee:u128,kind:&str,sig:u8,now:i64)->Result<()>{validate(&v.to_string(),"execution_1","owner","wallet","123","condition",1000000,2000000,fee,kind,sig,now)}
+ #[test]fn accepts_bounded_order(){assert!(run(data(),1000,"FOK",3,1000).is_ok())}
+ #[test]fn rejects_fee_growth(){assert!(run(data(),1001,"FOK",3,1000).is_err())}
+ #[test]fn rejects_identity_and_limits(){for(k,v)in [("owner","other"),("wallet","other"),("tokenId","456"),("conditionId","other"),("executionId","other"),("maxOrderRaw","999999"),("maxPriceRaw","499999")]{let mut d=data();d[k]=v.into();assert!(run(d,1000,"FOK",3,1000).is_err(),"{}",k)}}
+ #[test]fn rejects_expired_and_other_policies(){assert!(run(data(),1000,"FOK",3,2000).is_err());assert!(run(data(),1000,"FAK",3,1000).is_err());assert!(run(data(),1000,"FOK",0,1000).is_err())}
+}
