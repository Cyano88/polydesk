+// Opt-in, bounded workaround for the observed CLOB allowance requirement.
+// This never runs during normal setup or a buy and never deploys a wallet.
+fn bounded_adapter_amount(amount: &str) -> Result<u128> {
+    let parts: Vec<&str> = amount.split('.').collect();
+    anyhow::ensure!(parts.len() <= 2 && !parts[0].is_empty() && parts[0].bytes().all(|b| b.is_ascii_digit()), "Invalid allowance amount");
+    let frac = parts.get(1).copied().unwrap_or("");
+    anyhow::ensure!(frac.len() <= 6 && (parts.len() == 1 || !frac.is_empty()) && frac.bytes().all(|b| b.is_ascii_digit()), "Allowance requires at most six decimals");
+    let whole: u128 = parts[0].parse()?;
+    anyhow::ensure!(whole <= 4, "Allowance exceeds the approved 4 pUSD cap");
+    let raw = whole * 1_000_000 + format!("{0:0<6}", frac).parse::<u128>()?;
+    anyhow::ensure!(raw > 0 && raw <= 4_000_000, "Allowance must be positive and at most 4 pUSD");
+    Ok(raw)
+}
+
+fn bounded_adapter_call(raw: u128) -> WalletCall {
+    WalletCall { target: Contracts::PUSD.to_string(), value: 0,
+        data: format!("0x095ea7b3{}{:064x}", pad_address_hex(Contracts::NEG_RISK_ADAPTER), raw) }
+}
+
+pub async fn repair_adapter_allowance(amount: &str, dry_run: bool) -> Result<()> {
+    let unlimited = amount == "unlimited";
+    let raw = if unlimited { 0 } else { bounded_adapter_amount(amount)? };
+    let expected_hex = if unlimited { "f".repeat(64) } else { format!("{:064x}",raw) };
+    let owner = get_wallet_address().await?;
+    let stored = crate::config::load_credentials_for(&owner)?.ok_or_else(|| anyhow::anyhow!("Existing deposit-wallet credentials required"))?;
+    anyhow::ensure!(stored.mode == TradingMode::DepositWallet, "Deposit-wallet mode required");
+    let wallet = crate::onchainos::get_existing_deposit_wallet(&owner).await.ok_or_else(|| anyhow::anyhow!("Existing wallet ownership could not be verified"))?;
+    anyhow::ensure!(stored.deposit_wallet.as_deref().map(|v| v.eq_ignore_ascii_case(&wallet)).unwrap_or(false), "Stored wallet differs from verified owner wallet");
+    let allowance = exact_adapter_allowance(&wallet).await?;
+    let already_approved = allowance == expected_hex;
+    anyhow::ensure!(allowance.chars().all(|c| c == '0') || already_approved, "Existing nonzero allowance differs; explicit replacement review required");
+    if dry_run || already_approved {
+        println!("{}", serde_json::json!({"ok":true,"dry_run":dry_run,"data":{
+            "owner":owner,"wallet":wallet,"token":Contracts::PUSD,"spender":Contracts::NEG_RISK_ADAPTER,
+            "allowance_pusd":amount,"allowance_uint256_hex":expected_hex,"unlimited":unlimited,"call_count":1,"native_value":"0",
+            "already_approved":already_approved,"route":"deposit-wallet-relayer","gas":"relayer-funded",
+            "note":"Approval only. Unlimited has no expiry and covers future pUSD deposits; the order cap does not bound this allowance. No trade or token transfer. Existing market incident guard remains."}}));
+        return Ok(());
+    }
+    let client=Client::new();
+    let builder=get_builder_api_key(&client,&stored,&owner).await?;
+    let nonce=get_wallet_nonce(&client,&owner).await?;
+    let deadline=std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH)?.as_secs()+300;
+    let mut call=bounded_adapter_call(raw);
+    if unlimited { call.data = format!("0x095ea7b3{}{}",pad_address_hex(Contracts::NEG_RISK_ADAPTER),expected_hex); }
+    let calls_json=vec![serde_json::json!({"target":call.target,"value":"0","data":call.data})];
+    let params=BatchParams {wallet:wallet.clone(),nonce,deadline,calls:vec![call]};
+    let signature=sign_batch_via_onchainos(&params).await?;
+    let tx=relayer_wallet_batch(&client,&owner,&wallet,nonce,deadline,calls_json,&signature,&builder).await?;
+    crate::onchainos::wait_for_tx_receipt(&tx,120).await?;
+    let verified=exact_adapter_allowance(&wallet).await?;
+    anyhow::ensure!(verified == expected_hex, "Approval receipt confirmed but exact allowance verification failed");
+    sync_balance_allowance_deposit_wallet(&client,&wallet,&owner,&stored).await?;
+    println!("{}",serde_json::json!({"ok":true,"approval_tx":tx,"allowance_uint256_hex":verified,"unlimited":unlimited,"trade_submitted":false}));
+    Ok(())
+}
