+
+async fn exact_adapter_allowance(wallet: &str) -> Result<String> {
+    let body=serde_json::json!({"jsonrpc":"2.0","id":1,"method":"eth_call","params":[{"to":Contracts::PUSD,"data":format!("0xdd62ed3e{}{}",pad_address_hex(wallet),pad_address_hex(Contracts::NEG_RISK_ADAPTER))},"latest"]});
+    let value:serde_json::Value=Client::new().post(crate::config::Urls::polygon_rpc()).json(&body).send().await?.error_for_status()?.json().await?;
+    anyhow::ensure!(value.get("error").is_none(),"Allowance RPC failed");
+    let raw=value["result"].as_str().ok_or_else(||anyhow::anyhow!("Missing allowance"))?.strip_prefix("0x").ok_or_else(||anyhow::anyhow!("Invalid allowance encoding"))?;
+    anyhow::ensure!(raw.len()==64 && raw.bytes().all(|b|b.is_ascii_hexdigit()),"Invalid uint256 allowance response");
+    Ok(raw.to_ascii_lowercase())
+}
