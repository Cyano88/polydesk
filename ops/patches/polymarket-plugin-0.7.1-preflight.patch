+#[cfg(test)]
+mod bounded_adapter_tests {
+    use super::*;
+    #[test]
+    fn refuses_excess_or_ambiguous_allowances() {
+        for bad in ["0","4.000001","5","-1","1e0","1.0000001","1.",".1","1.2.3", "999999999999999999999999999999999999999999"] { assert!(bounded_adapter_amount(bad).is_err(), "{}", bad); }
+        assert_eq!(bounded_adapter_amount("3.751").unwrap(),3_751_000);
+        assert_eq!(bounded_adapter_amount("4").unwrap(),4_000_000);
+    }
+    #[test]
+    fn encodes_only_exact_collateral_approval() {
+        let call=bounded_adapter_call(3_751_000);
+        assert_eq!(call.target,Contracts::PUSD); assert_eq!(call.value,0);
+        assert_eq!(call.data.len(),138);
+        assert!(call.data.starts_with("0x095ea7b3"));
+        assert_eq!(u128::from_str_radix(&call.data[74..],16).unwrap(),3_751_000);
+        assert_eq!(&call.data[10..74],pad_address_hex(Contracts::NEG_RISK_ADAPTER));
+    }
+}
