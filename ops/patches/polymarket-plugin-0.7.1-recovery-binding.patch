+/// Persist only public unsigned order fields before signing/submission. Recovery
+/// derives the exact order hash; signatures and API credentials never enter it.
+pub fn persist_recovery_binding(order: &crate::signing::OrderParamsV2, owner: &str, condition: &str, neg_risk: bool) -> Result<()> {
+    use std::io::Write;
+    let path = match std::env::var("POLYDESK_RECOVERY_BINDING_PATH") { Ok(path) => path, Err(_) => return Ok(()) };
+    let execution_id = std::env::var("POLYDESK_EXECUTION_ID").context("Missing recovery execution ID")?;
+    let value = serde_json::json!({
+        "schema":"polydesk-order-binding-v1", "executionId":execution_id,
+        "owner":owner, "conditionId":condition,
+        "exchange":Contracts::exchange(OrderVersion::V2,neg_risk),
+        "order": {"salt":order.salt.to_string(),"maker":order.maker,"signer":order.signer,
+            "tokenId":order.token_id,"makerAmount":order.maker_amount.to_string(),"takerAmount":order.taker_amount.to_string(),
+            "side":order.side,"signatureType":order.signature_type,"timestamp":order.timestamp_ms.to_string(),
+            "metadata":order.metadata,"builder":order.builder}
+    });
+    let mut file = std::fs::OpenOptions::new().write(true).create_new(true).open(path)
+        .context("Recovery binding already exists or cannot be persisted; refusing submission")?;
+    file.write_all(serde_json::to_string(&value)?.as_bytes())?;
+    file.sync_all()?;
+    Ok(())
+}
