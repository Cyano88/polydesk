+#[cfg(test)]
+mod recovery_binding_tests {
+    use super::*;
+    #[test]
+    fn persists_public_exact_order_once_without_credentials_or_signature() {
+        let path=std::env::temp_dir().join(format!("polydesk-recovery-binding-{}-{}.json",std::process::id(),std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_nanos()));
+        std::env::set_var("POLYDESK_RECOVERY_BINDING_PATH",&path);
+        std::env::set_var("POLYDESK_EXECUTION_ID","test:recovery:001");
+        let order=crate::signing::OrderParamsV2 {salt:9007199254740993,maker:"0x1111111111111111111111111111111111111111".into(),signer:"0x1111111111111111111111111111111111111111".into(),token_id:"111".into(),maker_amount:3100000,taker_amount:10000000,side:0,signature_type:3,timestamp_ms:1800000000000,metadata:crate::signing::BYTES32_ZERO.into(),builder:crate::signing::BYTES32_ZERO.into()};
+        persist_recovery_binding(&order,"0x2222222222222222222222222222222222222222","condition",false).unwrap();
+        let value:serde_json::Value=serde_json::from_str(&std::fs::read_to_string(&path).unwrap()).unwrap();
+        assert_eq!(value["order"]["salt"],"9007199254740993");
+        assert_eq!(value["executionId"],"test:recovery:001");
+        assert!(value["order"].get("signature").is_none());
+        assert!(value.get("credentials").is_none());
+        assert!(persist_recovery_binding(&order,"owner","condition",false).is_err());
+        std::env::remove_var("POLYDESK_RECOVERY_BINDING_PATH");std::env::remove_var("POLYDESK_EXECUTION_ID");
+        std::fs::remove_file(path).unwrap();
+    }
+}
