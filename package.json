{
  "name": "polydesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "start": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "test:polydesk-shell": "node --import tsx --test scripts/polydesk-shell-ui.test.ts",
    "test:polymarket-alerts": "node --import tsx --test scripts/polymarket-alert-rules.test.ts",
    "test:email-provider": "node --import tsx --test scripts/email-provider.test.ts",
    "test:hashpaylink-funding": "node --import tsx --test scripts/hashpaylink-polymarket-funding.test.ts",
    "test:hashpaylink-agentic": "node --import tsx --test scripts/hashpaylink-agentic-checkout.test.ts",
    "test:lp-scout-boundary": "node --import tsx --test scripts/lp-scout-zeroscout-boundary.test.ts",
    "test:hashpaylink-url": "node --import tsx --test scripts/hashpaylink-url.test.ts",
    "test:hashpaylink-webhook": "node --import tsx --test scripts/hashpaylink-webhook.test.ts",
    "test:telegram-funding": "node --import tsx --test scripts/telegram-funding-request.test.ts",
    "test:okx-lp-scout": "node --import tsx --test scripts/okx-a2mcp-lp-scout.test.ts",
    "test:signed-open": "node --import tsx --test scripts/polymarket-signed-open.test.ts",
    "test:governed-open": "node --import tsx --test scripts/polymarket-governed-open.test.ts",
    "test:open-prepare": "node --import tsx --test scripts/polymarket-open-prepare.test.ts",
    "test:copy-prepare": "node --import tsx --test scripts/polymarket-copy-prepare.test.ts",
    "test:football-provider": "node --import tsx --test scripts/football-provider-routing.test.ts",
    "test:account-readiness": "node --import tsx --test scripts/polymarket-account-readiness.test.ts",
    "test:lp-context": "node --import tsx --test scripts/lp-context-intelligence.test.ts",
    "test:helper-memory": "node --import tsx --test scripts/helper-memory.test.ts",
    "test:okx-discovery": "node --import tsx --test scripts/okx-marketplace-discovery.test.ts",
    "test:okx-rewards": "node --import tsx --test scripts/okx-rewards.test.ts",
    "rewards:payout:dry-run": "tsx scripts/okx-rewards-payout-worker.ts",
    "rewards:proofs:dry-run": "tsx scripts/okx-rewards-proof-audit.ts",
    "rewards:rehearsal:submit": "tsx scripts/okx-rewards-rehearsal-submit.ts",
    "rewards:wallet:check": "tsx scripts/okx-rewards-wallet-eligibility.ts",
    "rewards:review": "tsx scripts/okx-rewards-review.ts",
    "rewards:launch:check": "tsx scripts/okx-rewards-launch-check.ts",
    "demo:okx:preflight": "node scripts/okx-demo-preflight.mjs",
    "example:open-prepare": "node examples/polymarket-open-prepare.mjs",
    "env:check": "node scripts/validate-env.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@0gfoundation/0g-ts-sdk": "^1.2.8",
    "@okxweb3/x402-core": "^0.1.0",
    "@okxweb3/x402-evm": "^0.2.1",
    "@okxweb3/x402-express": "^0.1.1",
    "@polymarket/builder-relayer-client": "^0.0.10",
    "@polymarket/builder-signing-sdk": "^1.0.0",
    "@polymarket/clob-client-v2": "^1.0.8",
